# Digital Loyalty Cards for Apple Wallet & Google Wallet — environment template.
# Copy to .env.local (gitignored) and fill in. NEVER commit real values.
# Nothing here is NEXT_PUBLIC_ except the base URL: every secret stays server-side.

# ---------------------------------------------------------------------------
# Supabase — the service-role key is server-only and must never reach the browser.
# Local (npm run db:start): URL http://127.0.0.1:55621 and the local Supabase CLI
# secret key (see README → Local development). Production: your project's URL +
# secret (service-role) key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------------------------------------------------------------------------
# App secrets
# Staff PIN for the dashboard and the member page reached by scanning a card.
MERCHANT_PIN=change-me-6-digits
# Signs customer links (/added, pass download, Google save link) and the staff
# session cookie. Generate with: openssl rand -hex 32
APP_SECRET=
# Shared secret the review-nudge cron route checks (Authorization: Bearer ...).
CRON_SECRET=change-me

# Public HTTPS origin (production). Used in the passes (QR code, Apple web
# service URL, Google logo). Leave empty locally: it is derived from the request.
NEXT_PUBLIC_BASE_URL=https://your-deployment.vercel.app

# Optional: shop location, so the Apple pass shows on the lock screen nearby.
SHOP_LATITUDE=
SHOP_LONGITUDE=

# ---------------------------------------------------------------------------
# Apple Wallet (Pass Type ID certificate from your Apple Developer account).
# The three PEM values are BASE64-ENCODED, one line each (nothing lands on disk):
#   base64 -i certs/signerCert.pem | tr -d '\n'
#   base64 -i certs/signerKey.pem  | tr -d '\n'
#   base64 -i certs/wwdr.pem       | tr -d '\n'   (Apple WWDR G4 certificate)
# The signer key must be unencrypted (no passphrase variable is supported).
# APNs push updates reuse this same Pass Type ID certificate (no separate .p8).
# For local testing only, `npm run certs:dev` prints self-signed values
# (iPhones reject those passes — they are NOT production credentials).
PASS_TYPE_ID=pass.com.example.loyalty
TEAM_ID=TEAMID1234
PASS_SIGNER_CERT=
PASS_SIGNER_KEY=
PASS_WWDR=

# ---------------------------------------------------------------------------
# Google Wallet (service-account JSON from Google Cloud + issuer ID from the
# Google Pay & Wallet Console). Same names as the service-account JSON fields.
# Required: WALLET_ISSUER_ID, CLIENT_EMAIL, PRIVATE_KEY. Leave them empty to
# hide the "Add to Google Wallet" button.
WALLET_ISSUER_ID=
TYPE=service_account
PROJECT_ID=
PRIVATE_KEY_ID=
# Keep the \n escapes, in double quotes, on one line:
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=wallet@your-project.iam.gserviceaccount.com
CLIENT_ID=
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=
UNIVERSE_DOMAIN=googleapis.com
# Loyalty class id suffix → class "<issuer>.<suffix>" (letters, digits, . _ -)
GOOGLE_WALLET_CLASS_SUFFIX=coffee_loyalty
# Public HTTPS logo Google can download (defaults to <base URL>/logo.png).
GOOGLE_WALLET_LOGO_URL=
