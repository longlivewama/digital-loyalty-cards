# Supabase — the service-role key is server-only and must never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Apple Wallet signing identity (Pass Type ID certificate).
# Both PEMs are passed as environment variables so nothing lands on disk in
# production; locally they can be read from certs/, which is gitignored.
PASS_TYPE_ID=pass.com.example.loyalty
TEAM_ID=TEAMID1234
PASS_SIGNER_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
PASS_SIGNER_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# PIN gating the merchant dashboard.
MERCHANT_PIN=000000

# Shared secret the review-nudge cron route checks before running.
CRON_SECRET=change-me

# Public origin, used to build pass web-service and join URLs.
NEXT_PUBLIC_BASE_URL=https://your-deployment.vercel.app
